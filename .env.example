# Copy to .env and fill in the real values. .env itself is gitignored — never commit it.

# Shared by both services (both read this same file)
# DEBUG additionally logs the full conversation each specialist sends the model, dimmed
# so it stays skimmable past. DEBUG | INFO | WARNING | ERROR | CRITICAL.
LOG_LEVEL=INFO

# services/chat (see services/chat/src/chat/core/config.py for the authoritative field list)
DATABASE_URL=postgresql+asyncpg://visitdoc:visitdoc@localhost:5432/visitdoc_chat
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=faq_chunks
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
SCHEDULING_GRPC_TARGET=localhost:50051
SCHEDULING_TIMEOUT_SECONDS=2.0
SCHEDULING_MAX_ATTEMPTS=2
SCHEDULING_RETRY_BACKOFF_SECONDS=0.25
GENERATION_MODEL=claude-sonnet-5
CLASSIFICATION_MODEL=claude-haiku-4-5-20251001
CONTEXT_TURNS=5
# How long a staff message - or the console's assistant switch - silences the assistant in that one
# conversation. Chosen, not derived: long enough to type a follow-up, short enough that a staff
# member who wandered off does not strand the patient (007 FR-013).
ASSISTANT_PAUSE_SECONDS=120
# Hard cap on one session's FAQ corpus. It exists because retrieval carries the session's live
# revisions as a filter term on every FAQ turn, so corpus size sits on that hot path (007 FR-039f).
FAQ_MAX_ENTRIES_PER_SESSION=200
# Where the console's practitioner proxy forwards to - the scheduler's own practitioner REST API.
# The browser never calls it directly: the session credential is an HttpOnly cookie it cannot read.
SCHEDULING_HTTP_BASE_URL=http://localhost:8001
# Guards the two session-deletion routes. UNSET OR EMPTY REFUSES EVERY REQUEST - a deployment that
# has not configured one has no admin, not an open door (007 FR-048a). Not an auth system, and not
# a user role: nobody logs in as an admin.
ADMIN_SECRET=

# services/scheduler (see services/scheduler/src/scheduler/core/config.py)
SCHEDULER_DATABASE_URL=postgresql+asyncpg://visitdoc:visitdoc@localhost:5432/visitdoc_scheduler
SCHEDULER_GRPC_PORT=50051
SCHEDULER_HTTP_PORT=8001
BOOKING_HORIZON_DAYS=90
AVAILABILITY_MAX_WINDOW_DAYS=14
AVAILABILITY_MAX_SLOTS=50
