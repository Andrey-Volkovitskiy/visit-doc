# Copy to .env and fill in the real values. .env itself is gitignored — never commit it.

# services/chat (see services/chat/src/chat/core/config.py for the authoritative field list)
DATABASE_URL=postgresql+asyncpg://visitdoc:visitdoc@localhost:5432/visitdoc_chat
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION_NAME=faq_chunks
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
SCHEDULING_GRPC_TARGET=localhost:50051
SCHEDULING_TIMEOUT_SECONDS=2.0
SCHEDULING_MAX_ATTEMPTS=2
SCHEDULING_RETRY_BACKOFF_SECONDS=0.25
GENERATION_MODEL=claude-sonnet-5
CLASSIFICATION_MODEL=claude-haiku-4-5-20251001
CONTEXT_TURNS=5

# services/scheduler (see services/scheduler/src/scheduler/core/config.py)
SCHEDULER_DATABASE_URL=postgresql+asyncpg://visitdoc:visitdoc@localhost:5432/visitdoc_scheduler
SCHEDULER_GRPC_PORT=50051
SCHEDULER_HTTP_PORT=8001
BOOKING_HORIZON_DAYS=90
AVAILABILITY_MAX_WINDOW_DAYS=14
AVAILABILITY_MAX_SLOTS=50
