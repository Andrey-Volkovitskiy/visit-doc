{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/py-check.sh\"",
            "timeout": 60,
            "statusMessage": "Running ruff + mypy..."
          },
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/ts-check.sh\"",
            "timeout": 60,
            "statusMessage": "Type-checking frontend..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/turn-changes.sh\" snapshot",
            "timeout": 20
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/turn-changes.sh\" report",
            "timeout": 20
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(uv run mypy *)",
      "Bash(.specify/scripts/bash/check-prerequisites.sh *)",
      "Bash(npm test)",
      "Bash(make lint)",
      "Bash(make typecheck)",
      "Bash(uv run ruff format --check *)",
      "Bash(make services-status)"
    ]
  }
}
