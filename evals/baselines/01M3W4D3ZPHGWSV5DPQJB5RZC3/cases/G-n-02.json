          "text_truncated": true
        },
        {
          "entry_id": 2854,
          "chunk_index": 0,
          "similarity_score": 0.3139643,
          "considered": false,
          "chunk_text": "# Appointment reminders and messages from the clinic\n## Text message reminders\n\nWe send a reminder by text message 48 hours before your appointment and another 2 hours before it. Our messages always c",
          "text_truncated": true
        },
        {
          "entry_id": 2856,
          "chunk_index": 4,
          "similarity_score": 0.30910042,
          "considered": false,
          "chunk_text": "# Your privacy and your health information\n## Questions and complaints about privacy\n\nOur privacy officer answers questions about how your information is used and handles privacy complaints. Ask the f",
          "text_truncated": true
        },
        {
          "entry_id": 2852,
          "chunk_index": 5,
          "similarity_score": 0.30892873,
          "considered": false,
