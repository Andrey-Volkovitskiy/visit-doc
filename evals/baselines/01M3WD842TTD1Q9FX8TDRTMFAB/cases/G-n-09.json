          "text_truncated": true
        },
        {
          "entry_id": 2987,
          "chunk_index": 1,
          "similarity_score": 0.28321356,
          "considered": false,
          "chunk_text": "# Appointment reminders and messages from the clinic\n## Email\n\nWe use email only to confirm a new appointment and to send an itemized receipt you have asked for. We do not send test results or medical",
          "text_truncated": true
        },
        {
          "entry_id": 2989,
