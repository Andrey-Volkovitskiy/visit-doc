          "text_truncated": true
        },
        {
          "entry_id": 2988,
          "chunk_index": 2,
          "similarity_score": 0.2745034,
          "considered": false,
          "chunk_text": "# Checking in and registering\n## Language interpreters\n\nFree telephone interpreting is available in more than 200 languages for any appointment. Ask for it when you book or when you check in; there is",
          "text_truncated": true
        },
        {
          "entry_id": 2983,
          "chunk_index": 6,
          "similarity_score": 0.27418348,
          "considered": false,
          "chunk_text": "# Dental care guide\n## Services we do not offer\n\nWe do not offer teeth whitening, orthodontic treatment such as braces or clear aligners, or dental implants.",
          "text_truncated": false
        },
        {
          "entry_id": 2986,
          "chunk_index": 0,
          "similarity_score": 0.2720437,
